# Minimal Sway session for Ubuntu 24.04.
# GNOME and GDM remain installed and unchanged; choose Sway at the login screen.

set $mod Mod4
set $terminal gnome-terminal
set $app_launcher rofi -show drun
set $command_launcher rofi -show run
set $window_switcher $HOME/.local/bin/sway-window-switcher
set $clipboard_menu $HOME/.local/bin/clipboard-menu
set $resize_helper $HOME/.local/bin/sway-smart-resize

font pango:JetBrains Mono 10

# French AZERTY, matching the keyboard layout in the previous configuration.
input type:keyboard {
    xkb_layout fr
    xkb_variant oss
}

# Generic touchpad preferences; no machine-specific device IDs.
input type:touchpad {
    natural_scroll disabled
    dwt enabled
    dwtp enabled
    tap enabled
}

# Dynamic, automatic tiling. Sway chooses split orientation from available space.
default_orientation auto
focus_follows_mouse yes
mouse_warping none
workspace_auto_back_and_forth yes

# Minimal appearance.
default_border pixel 1
default_floating_border pixel 1
smart_gaps on
gaps inner 1
gaps outer 0

# Catppuccin Mocha window colours.
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa #89b4fa
client.focused_inactive #45475a #1e1e2e #bac2de #45475a #45475a
client.unfocused        #313244 #1e1e2e #a6adc8 #313244 #313244
client.urgent           #f38ba8 #1e1e2e #1e1e2e #f38ba8 #f38ba8

# Plain dark background; no wallpaper dependency.
output * bg #1e1e2e solid_color

# Make the Wayland session environment available to D-Bus/systemd user services.
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

# Ubuntu's PolicyKit agent, not a custom service.
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

# Session utilities. `exec` avoids duplicate processes when the config is reloaded.
exec waybar
exec mako
exec nm-applet --indicator
exec swayidle -w timeout 300 'swaylock --config "$HOME/.config/swaylock/config" --show-failed-attempts --clock' before-sleep 'swaylock --config "$HOME/.config/swaylock/config" --show-failed-attempts --clock'
# Ubuntu 24.04 ships wl-clipboard 2.2.1. Set CLIPBOARD_TYPE explicitly
# rather than relying on the newer wl-paste behavior added after 2.3.0.
exec wl-paste --type text --watch sh -c 'export CLIPBOARD_TYPE=text/plain;charset=utf-8; exec cliphist store'
exec wl-paste --type image/png --watch sh -c 'export CLIPBOARD_TYPE=image/png; exec cliphist store'
exec wl-paste --type image/jpeg --watch sh -c 'export CLIPBOARD_TYPE=image/jpeg; exec cliphist store'
exec wl-paste --type image/webp --watch sh -c 'export CLIPBOARD_TYPE=image/webp; exec cliphist store'
exec sh -lc 'if [ -x "$HOME/.local/bin/flashfocus" ]; then exec "$HOME/.local/bin/flashfocus"; fi'

# Optional per-machine settings belong here, not in the managed baseline.
include $HOME/.config/sway/config.d/*.conf

# Applications and launchers.
bindsym $mod+Return exec $terminal
bindsym $mod+d exec $app_launcher
bindsym $mod+space exec $command_launcher
bindsym $mod+Tab exec $window_switcher
bindsym $mod+v exec $clipboard_menu
bindsym Alt+F4 kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+q exec swaylock --config "$HOME/.config/swaylock/config" --show-failed-attempts --clock
bindsym F11 fullscreen

# Directional focus and movement.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Directional resize. The helper grows toward an adjacent tiled window and
# shrinks toward the outer edge, avoiding unintuitive one-way resizing.
bindsym Control+$mod+Left exec $resize_helper left
bindsym Control+$mod+Down exec $resize_helper down
bindsym Control+$mod+Up exec $resize_helper up
bindsym Control+$mod+Right exec $resize_helper right

# Numbered workspaces. French AZERTY number-row keysyms are used so the
# physical number row works without requiring Shift.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+ampersand workspace $ws1
bindsym $mod+eacute workspace $ws2
bindsym $mod+quotedbl workspace $ws3
bindsym $mod+apostrophe workspace $ws4
bindsym $mod+parenleft workspace $ws5
bindsym $mod+minus workspace $ws6
bindsym $mod+egrave workspace $ws7
bindsym $mod+underscore workspace $ws8
bindsym $mod+ccedilla workspace $ws9
bindsym $mod+agrave workspace $ws10

bindsym $mod+Shift+ampersand move container to workspace $ws1
bindsym $mod+Shift+eacute move container to workspace $ws2
bindsym $mod+Shift+quotedbl move container to workspace $ws3
bindsym $mod+Shift+apostrophe move container to workspace $ws4
bindsym $mod+Shift+parenleft move container to workspace $ws5
bindsym $mod+Shift+minus move container to workspace $ws6
bindsym $mod+Shift+egrave move container to workspace $ws7
bindsym $mod+Shift+underscore move container to workspace $ws8
bindsym $mod+Shift+ccedilla move container to workspace $ws9
bindsym $mod+Shift+agrave move container to workspace $ws10

# Lock the touchpad toggle to a generic device selector.
bindsym $mod+F9 exec swaymsg input type:touchpad events toggle

# Audio, media and brightness keys. Ubuntu's PipeWire provides pactl compatibility.
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
