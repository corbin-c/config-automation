#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/sway-workstation"
LOG_FILE="$STATE_DIR/clipboard-menu.log"
mkdir -p "$STATE_DIR"

log() { printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG_FILE"; }
notify() { command -v notify-send >/dev/null 2>&1 && notify-send -t 2500 "Clipboard history" "$1" || true; }
fail() {
  local status=$?
  log "ERROR (exit $status, line ${BASH_LINENO[0]:-unknown}): ${BASH_COMMAND:-unknown command}"
  notify "Clipboard picker failed. See $LOG_FILE"
  exit "$status"
}
trap fail ERR

for cmd in cliphist rofi wl-copy; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log "Missing dependency: $cmd"
    notify "Missing command: $cmd"
    exit 127
  fi
done

history="$(cliphist list)"
if [[ -z "$history" ]]; then
  log "Picker opened with an empty history. Check the wl-paste listeners in the Sway session."
  notify "No clipboard history yet. Copy some text or an image first."
  exit 0
fi

# Keep the full selected TSV row so cliphist decode receives its numeric ID.
# Rofi displays only column 2, hiding the internal ID from the user.
if ! selection="$(printf '%s\n' "$history" | rofi -dmenu -i -p Clipboard -display-columns 2)"; then
  log "Picker cancelled or Rofi returned an error."
  exit 0
fi
[[ -n "$selection" ]] || exit 0

id="${selection%%$'\t'*}"
if [[ ! "$id" =~ ^[0-9]+$ ]]; then
  log "Invalid selected row (missing numeric cliphist ID)."
  notify "Invalid clipboard entry. See $LOG_FILE"
  exit 1
fi

mime="$(cliphist list -fields mime "$id")"
if [[ "$mime" == image/* ]]; then
  printf '%s\n' "$selection" | cliphist decode | wl-copy --type "$mime"
else
  printf '%s\n' "$selection" | cliphist decode | wl-copy
fi
log "Restored clipboard entry $id (MIME: ${mime:-unknown})."
