#!/usr/bin/env python3
"""Resize the focused tiled container in the requested direction."""
from __future__ import annotations
import json
import subprocess
import sys

OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
EPS = 2


def focused_node(node, ancestors=()):
    if node.get("focused") and node.get("type") in ("con", "floating_con"):
        return node, ancestors
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused_node(child, ancestors + (node,))
        if found:
            return found
    return None


def leaves(node, result):
    if node.get("type") == "con" and not node.get("nodes") and not node.get("floating_nodes"):
        result.append(node)
    for child in node.get("nodes", []):
        leaves(child, result)


def overlap_x(a, b):
    return a["x"] < b["x"] + b["width"] - EPS and b["x"] < a["x"] + a["width"] - EPS


def overlap_y(a, b):
    return a["y"] < b["y"] + b["height"] - EPS and b["y"] < a["y"] + a["height"] - EPS


def neighbor(f, other, direction):
    if direction == "right":
        return other["x"] >= f["x"] + f["width"] - EPS and overlap_y(f, other)
    if direction == "left":
        return other["x"] + other["width"] <= f["x"] + EPS and overlap_y(f, other)
    if direction == "down":
        return other["y"] >= f["y"] + f["height"] - EPS and overlap_x(f, other)
    return other["y"] + other["height"] <= f["y"] + EPS and overlap_x(f, other)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in OPPOSITE:
        raise SystemExit("usage: sway-smart-resize up|down|left|right")
    direction = sys.argv[1]
    tree = json.loads(subprocess.check_output(["swaymsg", "-r", "-t", "get_tree"], text=True))
    found = focused_node(tree)
    if not found:
        return
    focused, ancestors = found
    if focused.get("type") == "floating_con" or any(a.get("type") == "floating_con" for a in ancestors):
        subprocess.run(["swaymsg", "resize", "grow", direction], check=False)
        return
    workspace = next((a for a in ancestors if a.get("type") == "workspace"), None)
    if workspace is None:
        return
    all_leaves = []
    leaves(workspace, all_leaves)
    rect = focused.get("rect", {})
    has_neighbor = any(
        item is not focused and neighbor(rect, item.get("rect", {}), direction)
        for item in all_leaves
    )
    if has_neighbor:
        command = ["swaymsg", "resize", "grow", direction]
    else:
        command = ["swaymsg", "resize", "shrink", OPPOSITE[direction]]
    subprocess.run(command, check=False)


if __name__ == "__main__":
    main()
