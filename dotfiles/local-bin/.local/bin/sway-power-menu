#!/usr/bin/env bash
set -euo pipefail
command -v rofi >/dev/null || { echo "rofi is required" >&2; exit 1; }
action="$(printf '%s\n' 'Lock' 'Log out of Sway' 'Suspend' 'Reboot' 'Power off' | rofi -dmenu -i -p 'Power')" || exit 0
[[ -n "$action" ]] || exit 0
case "$action" in
  Lock) swaylock --config "$HOME/.config/swaylock/config" --show-failed-attempts --clock ;;
  'Log out of Sway') swaymsg exit ;;
  Suspend) systemctl suspend ;;
  Reboot| 'Power off')
    confirm="$(printf '%s\n' 'Cancel' 'Confirm' | rofi -dmenu -i -p "$action?")" || exit 0
    [[ "$confirm" == Confirm ]] || exit 0
    if [[ "$action" == Reboot ]]; then systemctl reboot; else systemctl poweroff; fi
    ;;
esac
