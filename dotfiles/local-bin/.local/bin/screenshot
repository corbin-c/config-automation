#!/usr/bin/env bash
set -euo pipefail

usage() { echo "Usage: screenshot copy-full|copy-area|save-full|save-area" >&2; exit 2; }
[[ $# -eq 1 ]] || usage
mode="$1"
command -v grim >/dev/null || { echo "grim is required" >&2; exit 1; }
case "$mode" in
  copy-full|copy-area|save-full|save-area) ;;
  *) usage ;;
esac

geometry=()
case "$mode" in
  *area)
    command -v slurp >/dev/null || { echo "slurp is required" >&2; exit 1; }
    selection="$(slurp)" || exit 0
    [[ -n "$selection" ]] || exit 0
    geometry=(-g "$selection")
    ;;
esac

case "$mode" in
  copy-*)
    command -v wl-copy >/dev/null || { echo "wl-copy is required" >&2; exit 1; }
    grim "${geometry[@]}" - | wl-copy --type image/png
    notify-send "Screenshot copied" "PNG image is available on the clipboard." 2>/dev/null || true
    ;;
  save-*)
    dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
    mkdir -p "$dir"
    file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
    grim "${geometry[@]}" "$file"
    notify-send "Screenshot saved" "$file" 2>/dev/null || true
    # If an annotation tool is installed separately, open the saved image in it.
    if command -v swappy >/dev/null 2>&1; then swappy -f "$file"; fi
    ;;
esac
