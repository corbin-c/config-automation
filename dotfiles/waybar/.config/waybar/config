{
  "layer": "top",
  "position": "left",
  "width": 12,
  "margin": 0,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["custom/wf-recorder", "sway/mode"],
  "modules-right": ["custom/clipboard", "battery", "network", "idle_inhibitor", "pulseaudio", "tray"],

  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{index}",
    "current-only": false
  },
  "battery": {
    "interval": 30,
    "states": {"warning": 15, "critical": 5},
    "format-charging": "",
    "format": "{icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format": "{ifname} ({essid}): {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {"activated": "", "deactivated": ""},
    "tooltip": true
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "tooltip-format": "{icon} {volume}% {format_source}",
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "tray": {"icon-size": 21, "spacing": 5},
  "custom/clipboard": {
    "format": "",
    "interval": 30,
    "exec": "cliphist list | wc -l",
    "tooltip": true,
    "on-click": "clipboard-menu",
    "on-click-right": "cliphist wipe"
  },
  "custom/wf-recorder": {
    "interval": 1,
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
    "exec": "printf '{\"class\":\"recording\",\"text\":\"\",\"tooltip\":\"Recording: Super+Shift+R, then r (silent) or Shift+r (with audio); Super+Escape stops\"}'",
    "exec-if": "pgrep -x wf-recorder",
    "on-click": "pkill -INT -x wf-recorder"
  }
}
