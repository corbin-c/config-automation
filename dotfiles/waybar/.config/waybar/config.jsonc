{
  "layer": "top",
  "position": "left",
  "width": 42,
  "spacing": 4,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "sway/mode",
    "custom/recording"
  ],
  "modules-right": [
    "custom/clipboard",
    "battery",
    "network",
    "pulseaudio",
    "idle_inhibitor",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{index}",
    "current-only": false
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
    "tooltip": false
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 15,
      "critical": 5
    },
    "format": "{icon}",
    "format-charging": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "ETH",
    "format-disconnected": "×",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "foot -e nmtui"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "Ⅱ",
      "deactivated": "Zz"
    },
    "tooltip": false
  },
  "clock": {
    "interval": 60,
    "format": "",
    "tooltip": true,
    "tooltip-format": "{:%A %d %B %Y}\n{:%H:%M:%S}"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6
  },
  "custom/clipboard": {
    "format": "",
    "tooltip": true,
    "exec": "cliphist list | wc -l",
    "exec-if": "command -v cliphist >/dev/null 2>&1",
    "interval": 30,
    "on-click": "sh -lc '$HOME/.local/bin/clipboard-menu'",
    "on-click-right": "cliphist wipe"
  },
  "custom/recording": {
    "exec": "$HOME/.local/bin/record-screen status",
    "return-type": "json",
    "interval": 2,
    "on-click": "$HOME/.local/bin/record-screen stop"
  }
}
