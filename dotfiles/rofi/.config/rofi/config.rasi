configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    font: "JetBrains Mono 10";
    terminal: "gnome-terminal";
    location: 0;
    width: 38;
    lines: 12;
    columns: 1;
    sorting-method: "normal";
    show-match: true;
    matching: "fuzzy";
}
* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    selected: #45475a;
    accent: #89b4fa;
    background-color: @bg;
    text-color: @fg;
    border-color: @accent;
}
window { width: 38em; border: 1px; border-radius: 8px; padding: 12px; }
mainbox { spacing: 7px; }
inputbar { children: [prompt, entry]; spacing: 8px; }
listview { lines: 12; columns: 1; spacing: 3px; }
element { padding: 6px 9px; border-radius: 5px; }
element selected { background-color: @selected; }
