configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    font: "JetBrains Mono 10";
    terminal: "foot";
    location: 0;
    width: 38;
    lines: 12;
    columns: 1;
    sorting-method: "normal";
    show-match: true;
    matching: "fuzzy";
}
* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    selected: #45475a;
    accent: #89b4fa;
    background-color: @bg;
    text-color: @fg;
    border-color: @accent;
}
window { width: 38em; border: 2px; border-radius: 10px; padding: 14px; }
mainbox { spacing: 8px; }
inputbar { children: [prompt, entry]; spacing: 8px; }
listview { lines: 12; columns: 1; spacing: 4px; }
element { padding: 7px 10px; border-radius: 6px; }
element selected { background-color: @selected; }
